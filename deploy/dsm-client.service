[Unit]
Description=DSM VPN client
# The client's unit. Never install deploy/dsm.service on a client: it runs
# DSM as a server, whatever the config says.
Documentation=file:///opt/dsm-repo/deploy/GUIDE.md
Documentation=file:///opt/dsm-repo/README.md
After=network-online.target
Wants=network-online.target

# StartLimit* is only honored in [Unit]. If DSM keeps failing at start,
# systemd stops trying after 5 starts in 10 minutes. After a crash the kill
# switch stays up even then (see ExecStopPost), so the host stays blocked,
# not open.
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
# The dsm process does not call sd_notify().
Type=simple

# nft / ip / sysctl live in /usr/sbin and /sbin. Pin PATH so the kill
# switch never fails to find nft.
Environment="PATH=/usr/sbin:/usr/bin:/sbin:/bin"

# Root for TUN, nftables, sysctl and /etc/resolv.conf; the tss group for
# the TPM (/dev/tpmrm0). deploy/dsm.service has the full notes.
User=root
SupplementaryGroups=tss

# The passphrase as a systemd credential, from /etc/dsm/passphrase (0600).
LoadCredential=passphrase:/etc/dsm/passphrase

ExecStart=/opt/dsm/venv/bin/dsm --mode client \
          --passphrase-env-file=${CREDENTIALS_DIRECTORY}/passphrase

# `systemctl stop` sends SIGTERM: DSM ends the session, takes the kill
# switch down and exits 0. When the tunnel drops, DSM does not exit: it
# keeps the kill switch up and reconnects by itself.
KillSignal=SIGTERM
TimeoutStopSec=30

# Take the kill switch down only after a stop you asked for: such a stop
# ends DSM with exit 0, so $SERVICE_RESULT is "success". After a crash, a
# kill or a stop timeout it is something else, and the kill switch stays up
# (fail closed) until DSM starts again or you run `sudo dsm cleanup`.
# Only the three client tables: `dsm cleanup` would also force
# net.ipv4.ip_forward to 0, which breaks Docker and other routing on a
# client. $$ passes a literal $ to the shell.
ExecStopPost=/bin/sh -c 'if [ "$$SERVICE_RESULT" = success ]; then for t in dsm_killswitch_pre dsm_killswitch dsm_dns_leak; do nft delete table inet "$$t" 2>/dev/null; done; fi; exit 0'

# DSM exits only when stopped (0), on a setup error at its first try (1;
# it took the kill switch down itself) or on a crash (the kill switch stays
# up). Restart=always brings it back after a crash; the new start replaces
# the old kill switch in one nft commit, so the host is never open between.
Restart=always
RestartSec=5s

StandardOutput=journal
StandardError=journal

# Sandboxing: the conservative subset of deploy/dsm.service (see its notes)
# with two differences. No CAP_NET_BIND_SERVICE: only the server's DNS
# proxy binds a low port (add it back if you set listen_port below 1024).
# No ProcSubset=pid: it hides /proc/sys, and the client writes
# net.ipv6.conf.*.disable_ipv6, net.ipv4.tcp_timestamps and
# net.ipv4.conf.all.src_valid_mark there.
MemoryDenyWriteExecute=true
LockPersonality=true
ProtectKernelModules=true
ProtectControlGroups=true
SystemCallArchitectures=native
NoNewPrivileges=true
RestrictSUIDSGID=true
ProtectHostname=true
ProtectClock=true
ProtectKernelLogs=true
RestrictRealtime=true
KeyringMode=private
CapabilityBoundingSet=CAP_NET_ADMIN CAP_IPC_LOCK
LimitMEMLOCK=infinity
LimitCORE=0
CoredumpFilter=0x00
UMask=0077
PrivateTmp=true
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
SystemCallFilter=@system-service
SystemCallFilter=~@clock @cpu-emulation @debug @module @mount @obsolete @raw-io @reboot @swap @privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
